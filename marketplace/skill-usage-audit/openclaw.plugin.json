{
  "id": "skill-usage-audit",
  "name": "Skill Usage Audit",
  "description": "Skill usage telemetry, execution tracking, and intelligent skill routing for OpenClaw. Writes audit data to SQLite.",
  "version": "1.1.6",
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dbPath": {
        "type": "string",
        "description": "SQLite database path for canonical telemetry. Defaults to ~/.openclaw/audits/skill-usage.db",
        "default": "~/.openclaw/audits/skill-usage.db"
      },
      "includeToolParams": {
        "type": "boolean",
        "description": "Whether to include tool params in tool_call_start/end events",
        "default": false
      },
      "captureMessageContent": {
        "type": "boolean",
        "description": "When true, store message text snapshots; when false, store only metadata + labels for privacy",
        "default": false
      },
      "redactKeys": {
        "type": "array",
        "description": "List of param keys to redact in tool event payloads",
        "items": {
          "type": "string"
        },
        "default": [
          "token",
          "apikey",
          "api_key",
          "apiKey",
          "password",
          "passwd",
          "auth",
          "authorization",
          "secret",
          "secretToken",
          "refreshToken",
          "client_secret"
        ]
      },
      "scrubPII": {
        "type": "boolean",
        "description": "When true, redact emails, phone numbers, and URL query strings. Secret/token patterns are always scrubbed regardless.",
        "default": true
      },
      "skillBlockDetection": {
        "type": "boolean",
        "description": "Whether to emit skill_block_detected events from before_prompt_build",
        "default": true
      },
      "contextWindowSize": {
        "type": "integer",
        "description": "Number of messages to retain before/after a skill read for execution context capture",
        "minimum": 1,
        "default": 5
      },
      "contextTimeoutMs": {
        "type": "integer",
        "description": "Max milliseconds to wait for follow-up messages before finalizing a skill execution record",
        "minimum": 0,
        "default": 60000
      },
      "router": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable router nudges. Audit telemetry still runs when this is false."
          },
          "targets": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "boolean",
                "default": true,
                "description": "Whether to nudge regular agent turns before prompt build"
              },
              "subagent": {
                "type": "boolean",
                "default": true
              },
              "cron": {
                "type": "boolean",
                "default": true
              }
            },
            "default": {
              "agent": true,
              "subagent": true,
              "cron": true
            }
          },
          "maxSkillsToNudge": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Default maximum skills to recommend per router nudge"
          },
          "agentMaxSkillsToNudge": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum skills to nudge for regular agent turns"
          },
          "subagentMaxSkillsToNudge": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum skills to nudge for subagent turns"
          },
          "cronMaxSkillsToNudge": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum skills to nudge for cron turns"
          },
          "minScore": {
            "type": "number",
            "default": 6,
            "description": "Default minimum score for subagent and cron nudges unless target-specific values are set"
          },
          "agentMinScore": {
            "type": "number",
            "default": 8,
            "description": "Minimum score for regular agent turns"
          },
          "subagentMinScore": {
            "type": "number",
            "description": "Minimum score for subagent turns"
          },
          "cronMinScore": {
            "type": "number",
            "description": "Minimum score for cron turns"
          },
          "recencyWindow": {
            "type": "integer",
            "minimum": 1,
            "default": 10,
            "description": "Skip nudging a skill if it was nudged within this many messages"
          },
          "recencyFallbackMinutes": {
            "type": "integer",
            "minimum": 0,
            "default": 30,
            "description": "Time fallback for recency checks when turn numbers are unavailable"
          },
          "lookbackMessages": {
            "type": "integer",
            "minimum": 1,
            "default": 8,
            "description": "Number of recent messages to score for regular agent turns"
          },
          "taskWindowMode": {
            "type": "string",
            "enum": [
              "recentMessages",
              "latestUser",
              "promptOnly"
            ],
            "default": "recentMessages",
            "description": "Which text window to score for routing"
          },
          "discovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "workspace": {
                "type": "boolean",
                "default": true
              },
              "agentsProject": {
                "type": "boolean",
                "default": true
              },
              "agentsPersonal": {
                "type": "boolean",
                "default": true
              },
              "openclawManaged": {
                "type": "boolean",
                "default": true
              },
              "openclawBundled": {
                "type": "boolean",
                "default": true
              },
              "extraDirs": {
                "type": "boolean",
                "default": true
              },
              "openclawPluginSkills": {
                "type": "boolean",
                "default": true
              },
              "codex": {
                "type": "boolean",
                "default": true
              },
              "codexPlugin": {
                "type": "boolean",
                "default": true
              },
              "groupDepth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3,
                "default": 1,
                "description": "Number of grouping directory levels below a skill root"
              }
            },
            "default": {}
          },
          "observability": {
            "type": "object",
            "additionalProperties": false,
            "description": "Router decision tracing for debugging why nudges did or did not fire",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Record compact router decision traces to SQLite"
              },
              "topCandidates": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20,
                "default": 5,
                "description": "Maximum scored candidates to keep in each decision trace"
              },
              "retentionDays": {
                "type": "integer",
                "minimum": 0,
                "default": 30,
                "description": "Delete router decision traces older than this many days during DB initialization; 0 disables cleanup"
              },
              "includeTaskExcerpt": {
                "type": "boolean",
                "default": false,
                "description": "Store a redacted task excerpt in decision traces. Disabled by default for privacy."
              }
            },
            "default": {
              "enabled": true,
              "topCandidates": 5,
              "retentionDays": 30,
              "includeTaskExcerpt": false
            }
          },
          "overrides": {
            "type": "array",
            "description": "Deterministic routing rules for workflows that should always recommend specific skills",
            "items": {
              "type": "object",
              "properties": {
                "taskPattern": {
                  "type": "string"
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "taskPattern",
                "skills"
              ]
            },
            "default": []
          },
          "skillKeywords": {
            "type": "object",
            "description": "Optional keyword boosts keyed by skill name or skill key",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "default": {}
          },
          "blocklist": {
            "type": "array",
            "description": "Skill names or keys that should never be recommended by the router",
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "default": {
          "enabled": true
        }
      }
    }
  }
}
